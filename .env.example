# Configuración de Supabase y Vercel.
# Nunca publiques claves reales en este archivo ni las subas a Git.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo para rutas de servidor y workers; nunca se expone al navegador.
# En Supabase actual comienza por sb_secret_.
SUPABASE_SECRET_KEY=

# Se define cuando exista el worker aislado de análisis.
ANALYSIS_WORKER_URL=
ANALYSIS_WORKER_SHARED_SECRET=
# URL pública de contacto incluida en el User-Agent del worker.
EVALEZ_CONTACT_URL=

# Se define después de elegir el proveedor de IA.
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
